(() => {
  'use strict';

  // ===== 設定 =====
  const LOOKUP_FIELD = '承認ルート';            // ルックアップのフィールドコード
  const KEY_VALUE    = '工作機廃棄願い・届用';  // 承認マスタで検索する値

  const TABLE_FIELD  = 'テーブル';              // ★テーブルのフィールドコードに変更
  const DATE_FIELD   = '廃棄日';                // テーブル内のフィールドコード
  const DEST_FIELD   = '廃棄先';                // テーブル内のフィールドコード
  const DEST_DEFAULT = '高柳商店';

  // ===== 共通処理 =====
  const today = () => {
    const d = new Date();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${d.getFullYear()}-${mm}-${dd}`;
  };

  // 1行ぶん：空欄のものだけ初期値を入れる
  const fillRow = (f) => {
    if (f[DATE_FIELD] && !f[DATE_FIELD].value) f[DATE_FIELD].value = today();
    if (f[DEST_FIELD] && !f[DEST_FIELD].value) f[DEST_FIELD].value = DEST_DEFAULT;
  };

  // 全行
  const fillRows = (record) => {
    const table = record[TABLE_FIELD];
    if (!table) return;
    table.value.forEach((row) => fillRow(row.value));
  };

  // ===== レコード追加画面の表示前 =====
  bst.event.on('bst.create.load', (event) => {
    const lookup = event.record[LOOKUP_FIELD];
    lookup.value  = KEY_VALUE;
    lookup.lookup = true;

    fillRows(event.record);
    return event;
  });

  // ===== テーブル行の追加前（＋ボタン） =====
  bst.event.on(`bst.row.add.${TABLE_FIELD}`, (event) => {
    const table = event.record[TABLE_FIELD];
    const row = table && table.value[event.rowindex];
    if (row) fillRow(row.value);   // 追加予定の行がレコード上にある場合のみ
    return event;
  });

  // ===== 保存前（念のため：空欄の行があっても必ず初期値が入る） =====
  bst.event.on('bst.create.submit', (event) => {
    fillRows(event.record);
    return event;
  });
})();
